# ============ 数据库（config/db_conf.py 读环境变量，不硬编码） ============
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_HOST=localhost
DB_PORT=3306
DB_NAME=news_app

# ============ 主 LLM 配置（二选一，通过 LLM_PROVIDER 切换） ============
# 复制本文件为 .env 并填入真实密钥（.env 不会提交到版本库）

# DeepSeek
DEEPSEEK_API_KEY=sk-你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=120
# DEEPSEEK_SYSTEM_PROMPT=你是一个 AI 新闻助手...

# Qwen（阿里云百炼 / DashScope，OpenAI 兼容接口）
# QWEN_API_KEY=sk-你的密钥
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3.7-flash
# QWEN_TIMEOUT=120
# 是否开启 qwen 思考：false(默认)关闭思考，大幅降输出 token；true 开启（回答更深入但更慢更贵）
# QWEN_ENABLE_THINKING=false
# 全局 LLM 输出 token 上限（qwen 推理模型默认 4096 防截断；关思考后可下调）
# MAX_TOKENS=4096

# ============ Agent / RAG 配置（可选，均有默认值） ============
# 主模型提供方（默认 deepseek；可选 qwen；新增 provider 需扩展 agents/model_factory.py）
# LLM_PROVIDER=deepseek
# Qdrant（本项目独立部署，端口 6335/6336）
# QDRANT_URL=http://localhost:6335
# QDRANT_COLLECTION=news_rag
# 嵌入服务（Docker 部署，见 docker/ 目录）
# TEXT_EMBEDDING_URL=http://localhost:8001
# IMAGE_EMBEDDING_URL=http://localhost:8002
# 检索条数
# RAG_TOP_K=5

# ============ 联网搜索 ============
# 文本搜索(Tavily,用于 web_search 工具)
# TAVILY_API_KEY=tvly-xxx
# 图片搜索(SerpAPI,用于自动配图联网兜底,engine=google_images)
# SERPAPI_KEY=xxx
# WEB_SEARCH_TOP_K=5
# IMAGE_SEARCH_TOP_K=4
# 图片向量相似度阈值(cosine,0~1),低于视为"无匹配"。占位图数据默认 0.40(拒绝占位图);真实图接入后下调
# IMAGE_SIM_THRESHOLD=0.40

# ============ 足球数据（Phase 1，专业足球 Agent） ============
# api-football 实时赛事（比赛结果/赛程/排名/球队/球员），注意变量名带连字符
API-FOOTBALL-API-KEY=你的key
# 默认赛季年份（可覆盖），如 2026
# API_FOOTBALL_SEASON=2026
# thesportsDB 球队/球员图片（队徽/球员照）
THESPORTDB-API-KEY=你的key

# ============ Redis 配置（可选，默认 localhost:6379） ============
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=
